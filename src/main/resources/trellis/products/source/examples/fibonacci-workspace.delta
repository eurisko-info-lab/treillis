delta-change "fibonacci-workspace"
message "Add a data-defined tail-recursive Fibonacci IR workspace"
author "trellis"
doc "guide" """
  |# FibonacciWorkspace: dynamic tail-recursive Fibonacci workspace
  |
  |FibonacciWorkspace adds a searchable Fibonacci workspace node connected to its complete
  |IR graph. Searching selects the node and offers an explicit Open Workspace
  |action. Studio then traverses outgoing semantic edges and generates the Graph,
  |pretty-printed Trellis, UML-like SVG, and Typst source views in memory.
  |
  |The reachable graph has a node for every function, parameter, match, case,
  |pattern, reference, constructor, call, and binary operation in the definition.
  |The Studio host contains no Fibonacci-specific behavior and no pre-generated
  |projection files are required. Attributes can optionally be expanded as
  |`core.attribute` leaf nodes in the Graph and SVG workspace views.
  |
  |## Frozen product identity
  |
  |```text
  |FibonacciWorkspace.delta
  |3d75aa4998b4fa644bbd1db09021e3760ecf96bb338df5dbc291502c573ae9d6
  |
  |FibonacciWorkspace root
  |a6cce0d8f88f55b4800f82c31b91752b45b12b29e6d45e05da4ac6a048dc129b
  |
  |766 nodes
  |807 edges
  |766 entities
  |74 delta operations
  |```
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "lsp-adapter"
  assert "introduces" "example.tailrec.fibonacci" "example.workspace"
depends "lsp-adapter"
  entity "example.tailrec.fibonacci" "example.workspace"
    port "definition" "out" "TrellisIr"
    attr "invariant" "current=fib(i);next=fib(i+1)"
    attr "name" "Tail-recursive Fibonacci"
    attr "query" "fib;fibonacci"
  entity "example.tailrec.fibonacci.function" "ir.function"
    port "parent" "in" "TrellisIr"
    port "parameter-0" "out" "TrellisIr"
    port "helper" "out" "TrellisIr"
    port "body" "out" "TrellisIr"
    attr "name" "fibonacci"
    attr "result" "Nat"
  entity "example.tailrec.fibonacci.parameter.n" "ir.parameter"
    port "parent" "in" "TrellisIr"
    attr "name" "n"
    attr "type" "Nat"
  entity "example.tailrec.fibonacci.helper" "ir.function"
    port "parent" "in" "TrellisIr"
    port "parameter-0" "out" "TrellisIr"
    port "parameter-1" "out" "TrellisIr"
    port "parameter-2" "out" "TrellisIr"
    port "body" "out" "TrellisIr"
    attr "name" "loop"
    attr "nested" "true"
    attr "result" "Nat"
  entity "example.tailrec.fibonacci.parameter.remaining" "ir.parameter"
    port "parent" "in" "TrellisIr"
    attr "name" "remaining"
    attr "type" "Nat"
  entity "example.tailrec.fibonacci.parameter.current" "ir.parameter"
    port "parent" "in" "TrellisIr"
    attr "name" "current"
    attr "type" "Nat"
  entity "example.tailrec.fibonacci.parameter.next" "ir.parameter"
    port "parent" "in" "TrellisIr"
    attr "name" "next"
    attr "type" "Nat"
  entity "example.tailrec.fibonacci.match" "ir.match"
    port "parent" "in" "TrellisIr"
    port "scrutinee" "out" "TrellisIr"
    port "case-0" "out" "TrellisIr"
    port "case-1" "out" "TrellisIr"
  entity "example.tailrec.fibonacci.ref.remaining" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "remaining"
  entity "example.tailrec.fibonacci.case.zero" "ir.case"
    port "parent" "in" "TrellisIr"
    port "pattern" "out" "TrellisIr"
    port "body" "out" "TrellisIr"
    attr "site" "zero"
  entity "example.tailrec.fibonacci.pattern.zero" "ir.pattern.constructor"
    port "parent" "in" "TrellisIr"
    attr "name" "zero"
  entity "example.tailrec.fibonacci.ref.current.base" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "current"
    attr "site" "base"
  entity "example.tailrec.fibonacci.case.succ" "ir.case"
    port "parent" "in" "TrellisIr"
    port "pattern" "out" "TrellisIr"
    port "body" "out" "TrellisIr"
    attr "site" "succ"
  entity "example.tailrec.fibonacci.pattern.succ" "ir.pattern.constructor"
    port "parent" "in" "TrellisIr"
    attr "binder" "rest"
    attr "name" "succ"
  entity "example.tailrec.fibonacci.call.recur" "ir.call"
    port "parent" "in" "TrellisIr"
    port "argument-0" "out" "TrellisIr"
    port "argument-1" "out" "TrellisIr"
    port "argument-2" "out" "TrellisIr"
    attr "callee" "loop"
    attr "tail" "true"
  entity "example.tailrec.fibonacci.ref.rest" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "rest"
  entity "example.tailrec.fibonacci.ref.next.recur" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "next"
    attr "site" "recur"
  entity "example.tailrec.fibonacci.add" "ir.binary"
    port "parent" "in" "TrellisIr"
    port "left" "out" "TrellisIr"
    port "right" "out" "TrellisIr"
    attr "operator" "+"
  entity "example.tailrec.fibonacci.ref.current.add" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "current"
    attr "site" "add-left"
  entity "example.tailrec.fibonacci.ref.next.add" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "next"
    attr "site" "add-right"
  entity "example.tailrec.fibonacci.call.initial" "ir.call"
    port "parent" "in" "TrellisIr"
    port "argument-0" "out" "TrellisIr"
    port "argument-1" "out" "TrellisIr"
    port "argument-2" "out" "TrellisIr"
    attr "callee" "loop"
  entity "example.tailrec.fibonacci.ref.n" "ir.reference"
    port "parent" "in" "TrellisIr"
    attr "name" "n"
  entity "example.tailrec.fibonacci.zero.initial" "ir.constructor"
    port "parent" "in" "TrellisIr"
    attr "name" "zero"
    attr "site" "initial"
  entity "example.tailrec.fibonacci.succ.initial" "ir.constructor"
    port "parent" "in" "TrellisIr"
    port "argument-0" "out" "TrellisIr"
    attr "name" "succ"
  entity "example.tailrec.fibonacci.zero.successor" "ir.constructor"
    port "parent" "in" "TrellisIr"
    attr "name" "zero"
    attr "site" "successor"
  connect "example.tailrec.fibonacci" "definition" "example.tailrec.fibonacci.function" "parent" "definition"
  connect "example.tailrec.fibonacci.function" "parameter-0" "example.tailrec.fibonacci.parameter.n" "parent" "parameter-0"
  connect "example.tailrec.fibonacci.function" "helper" "example.tailrec.fibonacci.helper" "parent" "helper"
  connect "example.tailrec.fibonacci.function" "body" "example.tailrec.fibonacci.call.initial" "parent" "body"
  connect "example.tailrec.fibonacci.helper" "parameter-0" "example.tailrec.fibonacci.parameter.remaining" "parent" "parameter-0"
  connect "example.tailrec.fibonacci.helper" "parameter-1" "example.tailrec.fibonacci.parameter.current" "parent" "parameter-1"
  connect "example.tailrec.fibonacci.helper" "parameter-2" "example.tailrec.fibonacci.parameter.next" "parent" "parameter-2"
  connect "example.tailrec.fibonacci.helper" "body" "example.tailrec.fibonacci.match" "parent" "body"
  connect "example.tailrec.fibonacci.match" "scrutinee" "example.tailrec.fibonacci.ref.remaining" "parent" "scrutinee"
  connect "example.tailrec.fibonacci.match" "case-0" "example.tailrec.fibonacci.case.zero" "parent" "case-0"
  connect "example.tailrec.fibonacci.match" "case-1" "example.tailrec.fibonacci.case.succ" "parent" "case-1"
  connect "example.tailrec.fibonacci.case.zero" "pattern" "example.tailrec.fibonacci.pattern.zero" "parent" "pattern"
  connect "example.tailrec.fibonacci.case.zero" "body" "example.tailrec.fibonacci.ref.current.base" "parent" "body"
  connect "example.tailrec.fibonacci.case.succ" "pattern" "example.tailrec.fibonacci.pattern.succ" "parent" "pattern"
  connect "example.tailrec.fibonacci.case.succ" "body" "example.tailrec.fibonacci.call.recur" "parent" "body"
  connect "example.tailrec.fibonacci.call.recur" "argument-0" "example.tailrec.fibonacci.ref.rest" "parent" "argument-0"
  connect "example.tailrec.fibonacci.call.recur" "argument-1" "example.tailrec.fibonacci.ref.next.recur" "parent" "argument-1"
  connect "example.tailrec.fibonacci.call.recur" "argument-2" "example.tailrec.fibonacci.add" "parent" "argument-2"
  connect "example.tailrec.fibonacci.add" "left" "example.tailrec.fibonacci.ref.current.add" "parent" "left"
  connect "example.tailrec.fibonacci.add" "right" "example.tailrec.fibonacci.ref.next.add" "parent" "right"
  connect "example.tailrec.fibonacci.call.initial" "argument-0" "example.tailrec.fibonacci.ref.n" "parent" "argument-0"
  connect "example.tailrec.fibonacci.call.initial" "argument-1" "example.tailrec.fibonacci.zero.initial" "parent" "argument-1"
  connect "example.tailrec.fibonacci.call.initial" "argument-2" "example.tailrec.fibonacci.succ.initial" "parent" "argument-2"
  connect "example.tailrec.fibonacci.succ.initial" "argument-0" "example.tailrec.fibonacci.zero.successor" "parent" "argument-0"
