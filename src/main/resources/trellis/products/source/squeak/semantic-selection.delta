delta-change "semantic-selection"
message "add synchronized Squeak semantic selection"
author "bootstrap"
doc "guide" """
  |# SemanticSelection: synchronized semantic selection
  |
  |SemanticSelection is the first explicitly named tooling product, layered over SqueakNavigator.
  |It resolves entity/node semantic equivalence once and maps the selection into
  |the semantic marks emitted by Code, SVG, and Typst projections.
  |
  |The graph policy selects the participating views, entity-node equivalence,
  |visibility behavior, and strict failure. Unknown selections, missing views, and
  |unsupported policy edits fail closed.
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "squeak-navigator"
  assert "introduces" "semantic-selection.schema" "squeak.schema"
depends "squeak-navigator"
  entity "semantic-selection.schema" "squeak.schema"
    attr "extends" "SqueakNavigator"
    attr "feature" "synchronized-semantic-selection"
    attr "name" "SemanticSelection"
  components "squeak.component" "SemanticSelection"
    component "synchronized-selection" "SynchronizedSelection"
    component "view-binding" "ViewBinding"
  rules "squeak.rule"
    rule "selection-equivalence" "entity-node-equivalence" "resolve-semantic-aliases"
    rule "selection-marks" "selection-marks" "map-selection-to-rendered-identifiers"
  entity "squeak.selection.policy" "squeak.selection-policy"
    attr "failure" "strict"
    attr "identity" "entity-node-equivalence"
    attr "views" "projection.code;projection.svg;projection.typst"
    attr "visibility" "allow-hidden"
