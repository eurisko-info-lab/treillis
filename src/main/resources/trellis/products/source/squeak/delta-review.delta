delta-change "delta-review"
message "add semantic DeltaTrellis review"
author "bootstrap"
doc "guide" """
  |# DeltaReview: semantic DeltaTrellis review
  |
  |DeltaReview derives review entries directly from canonical DeltaTrellis operations.
  |Each entry retains operation order, semantic subject, before/after content IDs,
  |and an entity/node/edge selection when applicable. Reviews also expose the
  |canonical footprint and materialized successor graph.
  |
  |The graph policy selects operation order, content-ID snapshots, semantic impact
  |selections, and strict failure.
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "typst-preview"
  assert "introduces" "delta-review.schema" "squeak.schema"
depends "typst-preview"
  entity "delta-review.schema" "squeak.schema"
    attr "extends" "TypstPreview"
    attr "feature" "semantic-delta-review"
    attr "name" "DeltaReview"
  components "squeak.component" "DeltaReview"
    component "delta-review" "DeltaReview"
    component "review-entry" "ReviewEntry"
    component "review-snapshot" "ReviewSnapshot"
    component "review-impact" "ReviewImpact"
  rules "squeak.rule"
    rule "review-operation-order" "operation-order" "preserve-delta-operation-order"
    rule "review-semantic-impact" "semantic-impact" "attach-semantic-selection"
  entity "squeak.delta.review-policy" "squeak.delta-review-policy"
    attr "failure" "strict"
    attr "impacts" "semantic-selection"
    attr "order" "operation-order"
    attr "snapshots" "content-id"
