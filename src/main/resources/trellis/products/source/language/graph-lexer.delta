delta-change "graph-lexer"
message "GraphLexer graph-resident lexer over TypedCaptures"
author "ai"
doc "guide" """
  |# GraphLexer: graph-resident lexical analysis
  |
  |GraphLexer is the fourth post-constitution grammar product layer. It is derived
  |from the immutable TypedCaptures product graph by one canonical DeltaTrellis change.
  |It is **not** F12 and does not modify the frozen F0-F11 bootstrap constitution.
  |
  |## Identity
  |
  |- TypedCaptures root: `c636319db67af7225fcdc617e2346fc60698992e9766393ae75441241dd55728`
  |- GraphLexer delta: `ff0a29e9f7871044896fe6c7931976c4a0c37babba8f8e689457fc1e3139ffc0`
  |- GraphLexer root: `02b13b975e32e0b4cc11b6a0bb4db6a711398e60975dc61338bd5e90ee24303c`
  |- Materialized graph: 398 nodes, 477 edges, 398 entities
  |
  |## Purpose
  |
  |TemplateGrammar through TypedCaptures interpret grammar semantics from Trellis data, but
  |the host still tokenizes source text by splitting on whitespace. GraphLexer
  |removes that host convention.
  |
  |A GraphLexer grammar selects a first-class lexer through a typed `grammar.lexer`
  |edge. The Bool0 lexer declares:
  |
  |- token source: the grammar's own first-class literal expressions;
  |- whitespace: Unicode whitespace;
  |- comment rule: `//` through end of line;
  |- token selection: longest match;
  |- deterministic tie break: lexical order;
  |- word boundary: identifier-like characters may not silently split keywords;
  |- failure policy: fail closed.
  |
  |The host therefore contains a generic scanner, but Bool0's terminals and lexer
  |policy remain graph data. Changing a grammar literal changes lexical
  |recognition without changing the scanner.
  |
  |## Example
  |
  |The same TypedCaptures AST language now accepts punctuation-adjacent source:
  |
  |```text
  |!true&&(false||true)
  |```
  |
  |and canonically prints:
  |
  |```text
  |! true && ( false || true )
  |```
  |
  |Comments and whitespace are likewise lexical policy:
  |
  |```text
  |true&&// comment
  |(false||!false)
  |```
  |
  |prints as:
  |
  |```text
  |true && ( false || ! false )
  |```
  |
  |## Versioned oracle
  |
  |`Language.typed-captures` remains the immutable TypedCaptures graph. `Language.graph`
  |advances to GraphLexer. TypedCaptures and GraphLexer must produce identical ASTs and
  |canonical output on the TypedCaptures whitespace-delimited surface.
  |
  |## Free changes
  |
  |`DeltaBool0` now admits the language-owned lexer definition, token source,
  |skip rules, and token-selection policy. All such edits still pass complete
  |language validation. A change that replaces deterministic longest-match
  |selection with an unsupported policy is rejected before publication.
  |
  |## Deliberate boundary
  |
  |GraphLexer derives tokens only from grammar literal expressions. It does not yet
  |provide identifier, numeric, string, escape, or user-defined character-class
  |lexemes. Those should be added as first-class lexical expressions rather than
  |as host regex strings.
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "typed-captures"
  assert "introduces" "grammar.component.lexer" "grammar.component"
depends "typed-captures"
  entity "grammar.component.lexer" "grammar.component"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "graph-resident lexical analysis selected by a grammar"
    attr "name" "Lexer"
    attr "slice" "GraphLexer"
  entity "lexer.component.definition" "lexer.component"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "declares one graph-resident lexer"
    attr "name" "LexerDefinition"
    attr "slice" "GraphLexer"
  entity "lexer.component.skip" "lexer.component"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "declares lexical input ignored before token selection"
    attr "name" "SkipRule"
    attr "slice" "GraphLexer"
  entity "lexer.component.selection" "lexer.component"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "declares deterministic token selection policy"
    attr "name" "Selection"
    attr "slice" "GraphLexer"
  entity "lexer.component.token-source" "lexer.component"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "declares where lexical terminals are obtained"
    attr "name" "TokenSource"
    attr "slice" "GraphLexer"
  entity "lexer4.schema" "lexer.schema"
    port "definition" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "skip" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "selection" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "token-source" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "first-class deterministic lexer over graph-derived grammar terminals"
    attr "name" "Lexer4"
    attr "slice" "GraphLexer"
  connect "lexer.component.definition" "self" "lexer4.schema" "definition" "lexer.component"
  connect "lexer.component.skip" "self" "lexer4.schema" "skip" "lexer.component"
  connect "lexer.component.selection" "self" "lexer4.schema" "selection" "lexer.component"
  connect "lexer.component.token-source" "self" "lexer4.schema" "token-source" "lexer.component"
  entity "graph-lexer.schema" "grammar.schema"
    port "expression" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "literal" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "reference" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "sequence" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "choice" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "optional" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
