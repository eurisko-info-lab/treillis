  disconnect "grammar.bool0.prod.false" "self" "grammar.bool0" "p02" "grammar.production"
  disconnect "grammar.bool0.prod.group" "self" "grammar.bool0" "p06" "grammar.production"
  disconnect "typed-captures.schema" "self" "grammar.bool0" "schema" "grammar.schema"
  disconnect "grammar.bool0.prod.or" "self" "grammar.bool0" "p05" "grammar.production"
  disconnect "grammar.bool0.prod.not" "self" "grammar.bool0" "p03" "grammar.production"
  disconnect "grammar.bool0.prod.true" "self" "grammar.bool0" "p01" "grammar.production"
