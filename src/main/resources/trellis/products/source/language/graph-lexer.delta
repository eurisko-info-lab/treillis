    port "associativity" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "lexer" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "description" "cardinality-aware combinator grammar with graph-resident lexical analysis"
    attr "name" "GraphLexer"
    attr "slice" "GraphLexer"
  connect "grammar.component.expression" "self" "graph-lexer.schema" "expression" "grammar.component"
  connect "grammar.component.literal" "self" "graph-lexer.schema" "literal" "grammar.component"
  connect "grammar.component.reference" "self" "graph-lexer.schema" "reference" "grammar.component"
  connect "grammar.component.sequence" "self" "graph-lexer.schema" "sequence" "grammar.component"
  connect "grammar.component.choice" "self" "graph-lexer.schema" "choice" "grammar.component"
  connect "grammar.component.optional" "self" "graph-lexer.schema" "optional" "grammar.component"
  connect "grammar.component.repeat" "self" "graph-lexer.schema" "repeat" "grammar.component"
  connect "grammar.component.capture" "self" "graph-lexer.schema" "capture" "grammar.component"
  connect "grammar.component.cardinality" "self" "graph-lexer.schema" "cardinality" "grammar.component"
  connect "grammar.component.precedence" "self" "graph-lexer.schema" "precedence" "grammar.component"
  connect "grammar.component.associativity" "self" "graph-lexer.schema" "associativity" "grammar.component"
  connect "grammar.component.lexer" "self" "graph-lexer.schema" "lexer" "grammar.component"
  entity "lexer.bool0.source.grammar-literals" "lexer.token-source"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "language" "language.bool0"
    attr "name" "grammar-literals"
    attr "slice" "GraphLexer"
    attr "source" "grammar-literals"
  entity "lexer.bool0.skip.whitespace" "lexer.skip-rule"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
