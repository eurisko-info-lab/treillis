    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "ambiguity" "unique"
    attr "expression-model" "first-class"
    attr "language" "language.bool0"
    attr "name" "Bool0Grammar"
    attr "normalization" "single-space"
    attr "parser" "prefix-recursive"
    attr "printer" "expression-graph"
    attr "slice" "ExpressionGrammar"
    attr "start-sort" "Expr"
    attr "tokenizer" "whitespace"
  connect "grammar.bool0.prod.true" "self" "grammar.bool0" "p01" "grammar.production"
  connect "grammar.bool0.prod.and" "self" "grammar.bool0" "p04" "grammar.production"
  connect "grammar.bool0.prod.false" "self" "grammar.bool0" "p02" "grammar.production"
  connect "grammar.bool0" "self" "language.bool0" "grammar" "language.grammar"
  connect "grammar.bool0.prod.not" "self" "grammar.bool0" "p03" "grammar.production"
  connect "expression-grammar.schema" "self" "grammar.bool0" "schema" "grammar.schema"
  disconnect "language.bool0.sort.Expr" "self" "grammar.bool0.prod.true" "sort" "grammar.sort"
  disconnect "language.bool0.ctor.True" "self" "grammar.bool0.prod.true" "constructor" "grammar.constructor"
  disconnect "grammar.bool0.prod.true" "self" "grammar.bool0" "p01" "grammar.production"
  replace "grammar.bool0.prod.true" "grammar.production"
    port "sort" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "constructor" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "body" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "language" "language.bool0"
    attr "priority" "10"
    attr "slice" "ExpressionGrammar"
    attr "sort" "Expr"
  connect "language.bool0.sort.Expr" "self" "grammar.bool0.prod.true" "sort" "grammar.sort"
  connect "language.bool0.ctor.True" "self" "grammar.bool0.prod.true" "constructor" "grammar.constructor"
  connect "grammar.bool0.prod.true" "self" "grammar.bool0" "p01" "grammar.production"
  disconnect "language.bool0.ctor.False" "self" "grammar.bool0.prod.false" "constructor" "grammar.constructor"
  disconnect "language.bool0.sort.Expr" "self" "grammar.bool0.prod.false" "sort" "grammar.sort"
  disconnect "grammar.bool0.prod.false" "self" "grammar.bool0" "p02" "grammar.production"
  replace "grammar.bool0.prod.false" "grammar.production"
    port "sort" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "constructor" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "body" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "self" "out" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    attr "language" "language.bool0"
