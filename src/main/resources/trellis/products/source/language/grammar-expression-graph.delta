  connect "grammar.bool0.prod.not" "self" "grammar.bool0" "p03" "grammar.production"
  disconnect "language.bool0.sort.Expr" "self" "grammar.bool0.prod.and" "sort" "grammar.sort"
  disconnect "grammar.bool0.prod.and" "self" "grammar.bool0" "p04" "grammar.production"
  disconnect "language.bool0.ctor.And" "self" "grammar.bool0.prod.and" "constructor" "grammar.constructor"
  replace "grammar.bool0.prod.and" "grammar.production"
