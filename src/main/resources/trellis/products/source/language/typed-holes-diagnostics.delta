    port "hole" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "recovery" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
    port "diagnostic" "in" "3:cap4:meta12:unrestricted14:4:atom6:Schema6:4:none"
