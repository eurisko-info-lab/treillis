delta-change "code-view"
message "add optional semantic Code View"
author "bootstrap"
doc "guide" """
  |# CodeView: optional semantic Code View
  |
  |CodeView wraps the existing noncanonical Code projection in an explicit optional
  |Studio contract. Graph policy controls enablement, one-based semantic line
  |anchors, selection reveal, and strict failure.
  |
  |Disabling the preview does not change projection data. When enabled, SemanticSelection
  |synchronized selection resolves to the stable line containing the selected
  |entity. LspAdapter later adapts these stable anchors to an LSP document.
  |
  |## Frozen product identity
  |
  |```text
  |CodeView.delta
  |7b1cae3f23e31a8d8e8a13f35bbe240de546d2a714b9e6dbdf80c87c8afd75a9
  |
  |CodeView root
  |8cc65a57874b0ea20b1cfc428f56bf53bbe5521709e5b9a360691cb45a7f1aee
  |
  |664 nodes
  |783 edges
  |664 entities
  |12 delta operations
  |```
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "delta-review"
  assert "introduces" "code-view.schema" "studio.schema"
depends "delta-review"
  entity "code-view.schema" "studio.schema"
    attr "extends" "DeltaReview"
    attr "feature" "optional-semantic-code-view"
    attr "name" "CodeView"
  components "studio.component" "CodeView"
    component "code-preview" "CodePreview"
    component "code-anchor" "CodeAnchor"
  rules "studio.rule"
    rule "code-optionality" "optionality" "enable-or-disable-code-preview"
    rule "code-selection-reveal" "selection-reveal" "map-selection-to-line"
  entity "studio.code.view-policy" "studio.code-view-policy"
    attr "enabled" "true"
    attr "failure" "strict"
    attr "lines" "one-based-semantic"
    attr "selection" "reveal"
