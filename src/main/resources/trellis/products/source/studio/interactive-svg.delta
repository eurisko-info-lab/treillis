delta-change "interactive-svg"
message "add interactive semantic SVG views"
author "bootstrap"
doc "guide" """
  |# InteractiveSvg: interactive semantic SVG views
  |
  |InteractiveSvg turns SVG semantic marks into deterministic interaction targets. Selected
  |renders emit keyboard focus, button roles, and `aria-selected` state directly on
  |node and edge elements, while ordinary SVG remains byte-compatible with the F5
  |projection oracle.
  |
  |The graph policy selects `select`/`activate` actions, semantic-target focus,
  |ARIA selected state, and strict failure. SemanticSelection entity/node equivalence drives
  |the same selected SVG target.
  |
  """
test "canonical delta contract"
  assert "canonical"
  assert "valid"
  assert "source-roundtrip"
  assert "dependency" "semantic-selection"
  assert "introduces" "interactive-svg.schema" "studio.schema"
depends "semantic-selection"
  entity "interactive-svg.schema" "studio.schema"
    attr "extends" "SemanticSelection"
    attr "feature" "interactive-svg-views"
    attr "name" "InteractiveSvg"
  components "studio.component" "InteractiveSvg"
    component "interaction-target" "InteractionTarget"
    component "interactive-svg" "InteractiveSvg"
  rules "studio.rule"
    rule "svg-semantic-focus" "semantic-focus" "keyboard-focus-semantic-targets"
    rule "svg-selected-state" "selected-state" "emit-aria-selected"
  entity "studio.svg.interaction-policy" "studio.svg-interaction-policy"
    attr "actions" "select;activate"
    attr "failure" "strict"
    attr "focus" "semantic-targets"
    attr "selected-state" "aria-selected"
